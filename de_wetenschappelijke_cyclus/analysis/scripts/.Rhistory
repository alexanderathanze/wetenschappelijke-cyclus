test = "Test 3"
)
combined_long <- rbind(test1_df, test2_df, test3_df)
library(tidyr)
ggplot(combined_long, aes(x = time, y = HR_bpm, color = test)) +
geom_line(size = 1) +
labs(
x = "Tijd (seconden)",
y = "Hartslag (bpm)",
title = "Hartslag tijdens test 1, 2 en 3"
) +
scale_color_manual(
values = c("Test 1" = "blue", "Test 2" = "orange", "Test 3" = "red"),
labels = c("Geen tijdsdruk", "Lichte tijdsdruk", "Hoge tijdsdruk")
) +
theme_minimal()
