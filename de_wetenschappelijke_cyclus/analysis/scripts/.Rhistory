x = "Meting",
y = "Systolisch (mmHg)"
) +
scale_fill_manual(values = c("Man" = "cyan", "Vrouw" = "lightcoral"))
# And for the gender of systolic bloodpressure
result_gender <- ezANOVA(
data    = df_long_sys_sorted,
dv      = waarde,
wid     = persoon,
within  = meting,
between = geslacht
)
# And for the gender of systolic bloodpressure
result_gender <- ezANOVA(
data    = df_long_sys_sorted,
dv      = waarde,
wid     = persoon,
within  = meting,
between = gender
)
result_gender$ANOVA
result_gender <- ezANOVA(
data    = df_long_dia_sorted,
dv      = waarde,
wid     = persoon,
within  = meting,
between = gender
)
result_gender$ANOVA
View(gender_pss_data)
library(readxl)
