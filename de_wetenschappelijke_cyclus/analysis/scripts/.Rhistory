waarde  = c(rust_systolic, toets_systolic_1, toets_systolic_2, toets_systolic_3)
)
df$meting <- factor(df$meting, levels = c("Rust", "Toets 1 - (geen tijd)", "Toets 2 - (1 minuut)", "Toets 3 - (30 seconden)"))
ggplot(df, aes(x = meting, y = waarde, fill = meting)) +
geom_boxplot()
labs(title = "Systolische bloeddruk per meting",
x = "Meting",
y = "Systolisch (mmHg)") +
theme_minimal()
