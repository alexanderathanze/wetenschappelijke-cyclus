verschil_df <- data.frame(
participant = seq_along(all_results),
verschil_1 = sapply(all_results, function(res) max(res$results_1) - res$results_1[1]),
verschil_2 = sapply(all_results, function(res) max(res$results_2) - res$results_2[1]),
verschil_3 = sapply(all_results, function(res) max(res$results_3) - res$results_3[1])
)
