# stap 6: gemiddeld verschil per conditie berekenen
gemiddeld_verschil_df <- data.frame(
conditie = factor(
c("Geen tijdsdruk", "Lichte tijdsdruk", "Hoge tijdsdruk"),
levels = c("Geen tijdsdruk", "Lichte tijdsdruk", "Hoge tijdsdruk")
),
gemiddeld_verschil = c(
mean(verschil_df$verschil_1),
mean(verschil_df$verschil_2),
mean(verschil_df$verschil_3)
)
)
# stap 7: lijndiagram gemiddeld verschil
ggplot(gemiddeld_verschil_df, aes(x = as.numeric(conditie), y = gemiddeld_verschil)) +
geom_line() +
geom_point(size = 3) +
scale_x_continuous(
breaks = 1:3,
labels = c("Geen tijdsdruk", "Lichte tijdsdruk", "Hoge tijdsdruk")
) +
labs(
title = "Gemiddeld hartslagverschil per conditie",
x     = "Conditie",
y     = "Gemiddeld verschil (bpm)"
) +
