n <- length(rust_diastolic)
persoon <- 1:n
df <- data.frame(
persoon = rep(persoon, 4),
meting  = rep(c("Rust", "Toets 1", "Toets 2", "Toets 3"), each = n),
waarde  = c(rust_diastolic, toets_diastolic_1, toets_diastolic_2, toets_diastolic_3)
)
# Zorg dat de volgorde op de x-as klopt
df$meting <- factor(df$meting, levels = c("Rust", "Toets 1", "Toets 2", "Toets 3"))
ggplot(df, aes(x = meting, y = waarde, group = persoon, color = as.factor(persoon))) +
geom_line() +
geom_point() +
labs(title = "Diastolische bloeddruk per meting",
x = "Meting",
y = "Diastolisch (mmHg)",
color = "Persoon") +
theme_minimal()
